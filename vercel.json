{
  "functions": {
    "api/chat.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/zoho/callback",
      "destination": "/api/zoho-callback"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/contact/",
      "destination": "/contact.html"
    },
    {
      "source": "/abzemo-ai",
      "destination": "/abzemo-ai.html"
    },
    {
      "source": "/abzemo-ai/",
      "destination": "/abzemo-ai.html"
    },
    {
      "source": "/careers",
      "destination": "/careers.html"
    },
    {
      "source": "/careers/",
      "destination": "/careers.html"
    },
       {
      "source": "/pregnancy-plus/:path*",
      "destination": "https://pregnancy-plus.vercel.app/:path*"
    },
    {
      "source": "/pregnancyplus/:path*",
      "destination": "https://pregnancy-plus.vercel.app/:path*"
    }
  ]
}
