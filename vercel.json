{
  "functions": {
    "api/chat.js": {
      "maxDuration": 30
    }
  },
    "redirects": [
    { "source": "/pregnancy-plus", "destination": "/pregnancy-plus/", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/zoho/callback",
      "destination": "/api/zoho-callback"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/contact/",
      "destination": "/contact.html"
    },
    {
      "source": "/abzemo-ai",
      "destination": "/abzemo-ai.html"
    },
    {
      "source": "/abzemo-ai/",
      "destination": "/abzemo-ai.html"
    },
    {
      "source": "/careers",
      "destination": "/careers.html"
    },
    {
      "source": "/careers/",
      "destination": "/careers.html"
    },
    {
      "source": "/pregnancy-plus",
      "destination": "https://pregnancy-plus.vercel.app/pregnancy-plus"
    },
    {
      "source": "/pregnancy-plus/:path*",
      "destination": "https://pregnancy-plus.vercel.app/pregnancy-plus/:path*"
    },
    {
      "source": "/pregnancy-plus/",
      "destination": "https://pregnancy-plus.vercel.app/pregnancy-plus/"
    },
        {
      "source": "/pregnancyplus",
      "destination": "https://pregnancy-plus.vercel.app/pregnancy-plus"
    },
    {
      "source": "/patient-file",
      "destination": "https://abzemo-patient-file.vercel.app/"
    },
    {
      "source": "/patient-file/:path*",
      "destination": "https://abzemo-patient-file.vercel.app/:path*"
    },
      {
      "source": "/pf-header.js",
      "destination": "https://abzemo-patient-file.vercel.app/pf-header.js"
    },
    {
      "source": "/(patient-health|chronic-care-assistant|lab-reports-assistant|hospital-management|pharmacy-medicine-management|telemedicine|mother-baby-care)",
      "destination": "/coming-soon.html"
    },
    {
      "source": "/(patient-health|chronic-care-assistant|lab-reports-assistant|hospital-management|pharmacy-medicine-management|telemedicine|mother-baby-care)/",
      "destination": "/coming-soon.html"
    }
  ]
}
