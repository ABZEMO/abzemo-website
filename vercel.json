{
  "functions": {
    "api/chat.js": {
      "maxDuration": 30
    }
  },
    "redirects": [
    { "source": "/pregnancy-plus", "destination": "/pregnancy-plus/", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/zoho/callback",
      "destination": "/api/zoho-callback"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/contact/",
      "destination": "/contact.html"
    },
    {
      "source": "/abzemo-ai",
      "destination": "/abzemo-ai.html"
    },
    {
      "source": "/abzemo-ai/",
      "destination": "/abzemo-ai.html"
    },
    {
      "source": "/careers",
      "destination": "/careers.html"
    },
    {
      "source": "/careers/",
      "destination": "/careers.html"
    },
    {
      "source": "/pregnancy-plus",
      "destination": "https://pregnancy-plus.vercel.app/pregnancy-plus"
    },
    {
      "source": "/pregnancy-plus/:path*",
      "destination": "https://pregnancy-plus.vercel.app/pregnancy-plus/:path*"
    },
    {
      "source": "/pregnancy-plus/",
      "destination": "https://pregnancy-plus.vercel.app/pregnancy-plus/"
    },
    {
      "source": "/pregnancyplus",
      "destination": "https://pregnancy-plus.vercel.app/pregnancy-plus"
    }
  ]
}
